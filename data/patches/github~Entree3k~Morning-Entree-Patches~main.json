        {
            "name": "Spoof install source",
            "description": "Makes the app think it was installed from a specific store (default: Google Play). Useful when an app blocks features or errors because it detects it was not installed from the Play Store. Only affects what the app sees, not the real system record.",
            "default": false,
            "dependencies": [],
            "compatiblePackages": null,
            "options": [
                {
                    "default": "com.android.vending",
                    "description": "Most apps only check for the Google Play Store, so the default is usually correct. Pick from the list, or type any package name directly.",
                    "key": "installerPackageName",
                    "required": true,
                    "title": "Store to impersonate",
                    "type": "kotlin.String",
                    "values": {
                        "Amazon Appstore": "com.amazon.venezia",
                        "F-Droid": "org.fdroid.fdroid",
                        "Google Play Store": "com.android.vending",
                        "Huawei AppGallery": "com.huawei.appmarket",
                        "Samsung Galaxy Store": "com.sec.android.app.samsungapps"
