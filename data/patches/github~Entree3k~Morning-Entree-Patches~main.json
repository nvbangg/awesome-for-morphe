{
    "version": "1.4.0",
    "name": "Morning Entree Patches",
    "patches": [
        {
            "name": "Always incognito mode",
            "description": "Always opens Gboard in incognito mode to disable typing-history collection and personalization, while keeping clipboard and voice typing working in incognito.",
            "default": true,
            "dependencies": [
                "BytecodePatch"
            ],
            "compatiblePackages": [
                {
                    "packageName": "com.google.android.inputmethod.latin",
                    "name": "Gboard",
                    "apkFileType": "APK",
                    "signatures": [
                        "7ce83c1b71f3d572fed04c8d40c5cb10ff75e6d87d9df6fbd53f0468c2905053",
                        "f0fd6c5b410f25cb25c3b53346c8972fae30f8ee7411df910480ad6b2d60db83"
                    ],
                    "targets": [
                        {
                            "isExperimental": false
                        }
                    ]
                }
            ],
            "options": []
        },
        {
            "name": "Block tracking and analytics",
            "description": "Redirects Gboard's known tracking, analytics, and ad host literals to 0.0.0.0 using a built-in blocklist. Note: telemetry sent through Google Play Services is not affected; use the always-incognito patch for that.",
            "default": false,
            "dependencies": [
                "BytecodePatch"
            ],
            "compatiblePackages": [
                {
                    "packageName": "com.google.android.inputmethod.latin",
                    "name": "Gboard",
                    "apkFileType": "APK",
                    "signatures": [
                        "7ce83c1b71f3d572fed04c8d40c5cb10ff75e6d87d9df6fbd53f0468c2905053",
                        "f0fd6c5b410f25cb25c3b53346c8972fae30f8ee7411df910480ad6b2d60db83"
                    ],
                    "targets": [
                        {
                            "isExperimental": false
                        }
                    ]
                }
            ],
            "options": [
                {
                    "default": true,
                    "description": "When enabled, an entry like \"example.com\" also blocks subdomains such as \"www.example.com\".",
                    "key": "isWildcard",
                    "required": false,
                    "title": "Wildcard blocking",
                    "type": "kotlin.Boolean",
                    "values": null
                }
            ]
        },
        {
            "name": "Change package name",
            "description": "Installs Gboard as a clone by appending \".clone\" to the package name (configurable), so it installs next to the stock Gboard. Changing an app's package name can lead to unexpected issues.",
            "default": false,
            "dependencies": [],
            "compatiblePackages": [
                {
                    "packageName": "com.google.android.inputmethod.latin",
                    "name": "Gboard",
                    "apkFileType": "APK",
                    "signatures": [
                        "7ce83c1b71f3d572fed04c8d40c5cb10ff75e6d87d9df6fbd53f0468c2905053",
                        "f0fd6c5b410f25cb25c3b53346c8972fae30f8ee7411df910480ad6b2d60db83"
                    ],
                    "targets": [
                        {
                            "isExperimental": false
                        }
                    ]
                }
            ],
            "options": [
                {
                    "default": "Default",
                    "description": "The package name to rename the app to. \"Default\" appends \".clone\".",
                    "key": "packageName",
                    "required": true,
                    "title": "Package name",
                    "type": "kotlin.String",
                    "values": {
                        "Default": "Default"
                    }
                },
                {
                    "default": true,
                    "description": "Update compatibility receiver permissions. Enabling this can fix installation errors, but can also break features in certain apps.",
                    "key": "updatePermissions",
                    "required": false,
                    "title": "Update permissions",
                    "type": "kotlin.Boolean",
                    "values": null
                },
                {
                    "default": true,
                    "description": "Update other permissions declared by the app. Enabling this can fix installation errors, but can also break features in certain apps.",
                    "key": "updateOtherPermissions",
                    "required": false,
                    "title": "Update other permissions",
                    "type": "kotlin.Boolean",
                    "values": null
                },
                {
                    "default": true,
                    "description": "Update content provider URI authorities. Enabling this can fix installation errors, but can also break features in certain apps.",
                    "key": "updateProviders",
                    "required": false,
                    "title": "Update content providers",
                    "type": "kotlin.Boolean",
                    "values": null
                }
            ]
        },
