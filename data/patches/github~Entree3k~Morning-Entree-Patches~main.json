                    "required": false,
                    "title": "Update other permissions",
                    "type": "kotlin.Boolean",
                    "values": null
                },
                {
                    "default": true,
                    "description": "Update content provider URI authorities. Enabling this can fix installation errors, but can also break features in certain apps.",
