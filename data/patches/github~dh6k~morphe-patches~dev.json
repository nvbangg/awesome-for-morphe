{
    "version": "1.1.0",
    "name": "Brave and universal patches",
    "patches": [
        {
            "name": "Brave Origin",
            "description": "Unlocks Brave Origin and enables feature toggle controls.",
            "default": true,
            "dependencies": [
                "Brave Origin Resource Defaults"
            ],
            "compatiblePackages": [
                {
                    "packageName": "com.brave.browser",
                    "name": "Brave Browser",
                    "apkFileType": "APKM",
                    "appIconColor": "#FF4500",
                    "signatures": [],
                    "targets": [
                        {
                            "version": "1.92.140",
                            "isExperimental": false
                        }
                    ]
                },
                {
                    "packageName": "com.brave.browser_beta",
                    "name": "Brave Beta",
                    "apkFileType": "APKM",
                    "appIconColor": "#FF4500",
                    "signatures": [],
                    "targets": [
                        {
                            "isExperimental": true
                        }
                    ]
                },
                {
                    "packageName": "com.brave.browser_nightly",
                    "name": "Brave Nightly",
                    "apkFileType": "APKM",
                    "appIconColor": "#FF4500",
                    "signatures": [],
                    "targets": [
                        {
                            "isExperimental": true
                        }
                    ]
                }
            ],
            "options": []
        },
        {
            "name": "Change app icon",
            "description": "Changes the Android launcher icon using a custom PNG image. Use a square image with transparent adaptive-icon padding.",
            "default": false,
            "dependencies": [],
            "compatiblePackages": null,
            "options": [
                {
                    "default": null,
                    "description": "Square PNG, 48-4096 px, maximum 256 KiB. Recommended: 432x432 px with transparent padding.",
                    "key": "customIcon",
                    "required": true,
                    "title": "Custom app icon",
                    "type": "kotlin.String",
                    "values": null
                }
            ]
        },
        {
            "name": "Change app name",
            "description": "Changes the app name shown by Android launchers. Set the desired name in the patch options.",
            "default": false,
            "dependencies": [],
            "compatiblePackages": null,
            "options": [
                {
                    "default": "Patched",
                    "description": "The name shown under the app icon.",
                    "key": "appName",
                    "required": true,
                    "title": "App name",
                    "type": "kotlin.String",
                    "values": null
                }
            ]
        }
    ]
}