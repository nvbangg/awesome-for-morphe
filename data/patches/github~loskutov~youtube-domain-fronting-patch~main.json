                }
            ],
            "options": [
                {
                    "default": "kek.bdn.dev",
                    "description": "Hostname written into libcronet and used by the SSLClientSocket path for TLS SNI.",
                    "key": "forcedSniHost",
                    "required": true,
                    "title": "Forced SNI hostname",
                    "type": "kotlin.String",
                    "values": null
                },
                {
