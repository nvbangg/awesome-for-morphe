    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@heroui/react": "^3.2.3",
    "@heroui/system": "^2.4.28",
    "@heroui/theme": "^2.4.26",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.29.0",
    "next-themes": "^0.4.6",
